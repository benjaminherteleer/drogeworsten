---
// Een schijfje droge worst, als los decor-element.
interface Props {
  class?: string;
  zaad?: number;
}
const { class: klasse, zaad = 1 } = Astro.props;

let s = zaad * 9301 + 49297;
const rnd = () => ((s = (s * 9301 + 49297) % 233280) / 233280);
const spikkels = Array.from({ length: 16 }, () => {
  const a = rnd() * Math.PI * 2;
  const r = Math.sqrt(rnd()) * 34;
  return { x: 50 + Math.cos(a) * r, y: 50 + Math.sin(a) * r, r: 1.6 + rnd() * 3.2, vet: rnd() < 0.8 };
});
---

<svg class:list={['plakje', klasse]} viewBox="0 0 100 100" aria-hidden="true">
  <circle cx="50" cy="50" r="47" fill="#a91d2b" />
  <circle cx="50" cy="50" r="41" fill="#d63a3c" />
  {spikkels.map((p) => <circle cx={p.x} cy={p.y} r={p.r} fill={p.vet ? '#fbe2d6' : '#9d2430'} />)}
</svg>
