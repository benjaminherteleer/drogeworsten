---
import '../styles/global.css';
import Nav from '../components/Nav.astro';
import Footer from '../components/Footer.astro';

interface Props {
  titel?: string;
  beschrijving?: string;
}
const {
  titel,
  beschrijving = 'Ambachtelijke droge worsten voor horeca en kleinhandel, al 10 jaar. Gewoon, gerookt, pikant, merguez en Rumbeekse. FAVV-gecertificeerd.',
} = Astro.props;
const volledigeTitel = titel ? `${titel} – Drogeworsten.be` : 'Drogeworsten.be – Ambachtelijke droge worsten voor horeca & kleinhandel';
const canonical = new URL(Astro.url.pathname.replace(/\.html$/, ''), Astro.site);
---

<!doctype html>
<html lang="nl">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{volledigeTitel}</title>
    <meta name="description" content={beschrijving} />
    <link rel="canonical" href={canonical} />
    <meta name="theme-color" content="#d3202a" />
    <link rel="icon" type="image/png" href="/favicon.png" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <meta property="og:site_name" content="Drogeworsten.be" />
    <meta property="og:title" content={volledigeTitel} />
    <meta property="og:description" content={beschrijving} />
    <meta property="og:type" content="website" />
    <meta property="og:url" content={canonical} />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=DM+Sans:opsz,wght@9..40,400;9..40,500;9..40,700&family=Rubik:wght@600;700;800;900&display=swap"
      rel="stylesheet"
    />
  </head>
  <body>
    <a href="#inhoud" class="skip">Naar de inhoud</a>
    <Nav />
    <main id="inhoud">
      <slot />
    </main>
    <Footer />

    <div class="scrollbalk" aria-hidden="true"></div>

    <script>
      const rustig = matchMedia('(prefers-reduced-motion: reduce)').matches;

      // Elementen die binnenschuiven
      const io = new IntersectionObserver(
        (items) =>
          items.forEach((i) => {
            if (i.isIntersecting) {
              i.target.classList.add('zichtbaar');
              io.unobserve(i.target);
            }
          }),
        { rootMargin: '0px 0px -8% 0px' },
      );
      document.querySelectorAll('.in').forEach((el) => io.observe(el));

      // Tellers die optellen zodra ze in beeld komen
      const telIo = new IntersectionObserver((items) =>
        items.forEach((i) => {
          if (!i.isIntersecting) return;
          telIo.unobserve(i.target);
          const el = i.target as HTMLElement;
          const doel = Number(el.dataset.tel);
          if (rustig) return void (el.textContent = String(doel));
          const start = performance.now();
          const stap = (nu: number) => {
            const t = Math.min((nu - start) / 1400, 1);
            el.textContent = String(Math.round(doel * (1 - Math.pow(1 - t, 3))));
            if (t < 1) requestAnimationFrame(stap);
          };
          requestAnimationFrame(stap);
        }),
      );
      document.querySelectorAll('[data-tel]').forEach((el) => telIo.observe(el));

      // Het mannetje: ogen volgen de cursor, knipperen, springen bij een klik
      const mannetjes = [...document.querySelectorAll<HTMLElement>('[data-mannetje]')];
      const kijk = (x: number, y: number) => {
        mannetjes.forEach((m) =>
          m.querySelectorAll<HTMLElement>('.oog').forEach((oog) => {
            const r = oog.getBoundingClientRect();
            const dx = x - (r.left + r.width / 2);
            const dy = y - (r.top + r.height / 2);
            const afstand = Math.hypot(dx, dy) || 1;
            const max = r.width * 0.32 * Math.min(afstand / 160, 1);
            const p = oog.firstElementChild as HTMLElement;
            p.style.setProperty('--px', `${(dx / afstand) * max}px`);
            p.style.setProperty('--py', `${(dy / afstand) * max}px`);
          }),
        );
      };
      addEventListener('pointermove', (e) => kijk(e.clientX, e.clientY), { passive: true });
      addEventListener('pointerdown', (e) => kijk(e.clientX, e.clientY), { passive: true });

      const knipper = (m: HTMLElement) => {
        m.classList.add('knipper');
        setTimeout(() => m.classList.remove('knipper'), 140);
      };
      mannetjes.forEach((m) => {
        const plan = () =>
          setTimeout(() => {
            knipper(m);
            if (Math.random() < 0.25) setTimeout(() => knipper(m), 260);
            plan();
          }, 2200 + Math.random() * 3800);
        plan();
        m.addEventListener('click', () => {
          m.classList.remove('spring');
          void m.offsetWidth;
          m.classList.add('spring');
          knipper(m);
          if (!rustig) worstenregen(m);
        });
      });

      // Droge worstjes die wegspringen als het mannetje springt, getekend zoals in het logo
      const worstje = () => {
        let spikkels = '';
        for (let i = 0; i < 7; i++) {
          const x = 18 + Math.random() * 60;
          const y = 14 + Math.random() * 10;
          spikkels += `<circle cx="${x}" cy="${y}" r="${1.6 + Math.random() * 1.8}" fill="#fbe2d6"/>`;
        }
        return `<svg viewBox="0 0 112 40"><path d="M98 18 q7 -2 9 -9 M98 20 q8 3 8 11" fill="none" stroke="#a91d2b" stroke-width="3.5" stroke-linecap="round"/><path d="M10 21 C 9 10, 30 7, 52 8 S 95 9, 97 18 C 99 28, 76 31, 54 30 S 11 33, 10 21 Z" fill="#d63a3c" stroke="#a91d2b" stroke-width="5" stroke-linejoin="round"/><path d="M26 13 C 40 10, 66 10, 84 13" fill="none" stroke="#e8706a" stroke-width="3" stroke-linecap="round"/>${spikkels}</svg>`;
      };
      const worstenregen = (m: HTMLElement) => {
        const r = m.getBoundingClientRect();
        const x = r.left + r.width / 2;
        const y = r.top + r.height * 0.42;
        for (let i = 0; i < 11; i++) {
          const el = document.createElement('span');
          el.className = 'vlieg';
          el.innerHTML = worstje();
          const breed = 64 + Math.random() * 40;
          el.style.cssText = `left:${x}px;top:${y}px;width:${breed}px;height:${breed * 0.36}px`;
          document.body.append(el);
          const hoek = -Math.PI / 2 + (Math.random() - 0.5) * 2.2;
          const kracht = 200 + Math.random() * 240;
          const vx = Math.cos(hoek) * kracht;
          const vy = Math.sin(hoek) * kracht;
          const start = Math.random() * 360;
          const draai = start + (Math.random() < 0.5 ? -1 : 1) * (240 + Math.random() * 360);
          el.animate(
            [
              { transform: `translate(-50%,-50%) rotate(${start}deg) scale(.4)`, opacity: 1 },
              { transform: `translate(calc(-50% + ${vx * 0.65}px), calc(-50% + ${vy * 0.65}px)) rotate(${(start + draai) / 2}deg) scale(1)`, opacity: 1, offset: 0.38 },
              { transform: `translate(calc(-50% + ${vx * 0.9}px), calc(-50% + ${vy * 0.3 + 300}px)) rotate(${draai * 0.9}deg) scale(1)`, opacity: 1, offset: 0.8 },
              { transform: `translate(calc(-50% + ${vx}px), calc(-50% + ${vy * 0.15 + 460}px)) rotate(${draai}deg) scale(1)`, opacity: 0 },
            ],
            { duration: 1400 + Math.random() * 500, easing: 'cubic-bezier(.25,.6,.45,1)', delay: Math.random() * 90 },
          ).onfinish = () => el.remove();
        }
      };

      // 3D-kantelen onder de cursor
      if (!rustig && matchMedia('(hover: hover)').matches) {
        document.querySelectorAll<HTMLElement>('[data-tilt]').forEach((el) => {
          const sterkte = Number(el.dataset.tilt) || 8;
          el.addEventListener('pointermove', (e) => {
            const r = el.getBoundingClientRect();
            const x = (e.clientX - r.left) / r.width - 0.5;
            const y = (e.clientY - r.top) / r.height - 0.5;
            el.style.setProperty('--rx', `${-y * sterkte}deg`);
            el.style.setProperty('--ry', `${x * sterkte}deg`);
            el.style.setProperty('--gx', `${(x + 0.5) * 100}%`);
            el.style.setProperty('--gy', `${(y + 0.5) * 100}%`);
          });
          el.addEventListener('pointerleave', () => {
            el.style.setProperty('--rx', '0deg');
            el.style.setProperty('--ry', '0deg');
          });
        });
      }

      // Parallax en scrollbalk
      const lagen = [...document.querySelectorAll<HTMLElement>('[data-parallax]')];
      const balk = document.querySelector<HTMLElement>('.scrollbalk')!;
      let wacht = false;
      const opScroll = () => {
        wacht = false;
        const y = scrollY;
        const max = document.documentElement.scrollHeight - innerHeight;
        balk.style.transform = `scaleX(${max > 0 ? y / max : 0})`;
        if (!rustig) lagen.forEach((l) => l.style.setProperty('--py', `${y * Number(l.dataset.parallax)}px`));
      };
      addEventListener(
        'scroll',
        () => {
          if (!wacht) {
            wacht = true;
            requestAnimationFrame(opScroll);
          }
        },
        { passive: true },
      );
      opScroll();
    </script>
  </body>
</html>

<style is:global>
  .skip {
    position: absolute;
    left: -999px;
    top: 0;
    z-index: 100;
    padding: 0.75rem 1rem;
    background: var(--inkt);
    color: var(--wit);
  }
  .skip:focus {
    left: 1rem;
  }
  .scrollbalk {
    position: fixed;
    top: 0;
    left: 0;
    right: 0;
    z-index: 60;
    height: 5px;
    transform-origin: 0 50%;
    transform: scaleX(0);
    background-color: var(--wit);
    background-image: var(--ruit-patroon);
    background-size: 10px 10px;
    pointer-events: none;
  }
  .vlieg {
    position: fixed;
    z-index: 150;
    pointer-events: none;
    filter: drop-shadow(0 4px 5px rgba(35, 24, 22, 0.2));
  }
  .vlieg svg {
    display: block;
    width: 100%;
    height: 100%;
    overflow: visible;
  }
</style>
